{
  "name": "protolearn-renderer",
  "version": "0.1.0",
  "private": true,
  "description": "知识点动画渲染工程：Remotion Composition + AI 生成的 props",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts Handshake out/handshake.mp4",
    "still": "remotion still src/index.ts Handshake out/frame.png --frame=150",
    "bundle": "remotion bundle src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.5.4"
  }
}
